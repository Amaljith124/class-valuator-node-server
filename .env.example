NODE_ENV=development
PORT=3000
APP_NAME=Humaniti API
DATABASE_URL=postgresql://postgres:password@localhost:5432/dbname
FASTAPI_BASE_URL=http://127.0.0.1:8000
FASTAPI_INTERNAL_TOKEN=replace-with-long-random-secret
API_ACCESS_TOKEN=replace-with-long-random-secret
CORS_ORIGIN=http://localhost:5173
PG_BOSS_QUEUE=video-analysis
PG_BOSS_BATCH_SIZE=1
PG_BOSS_POLL_SECONDS=2
FASTAPI_TIMEOUT_MS=900000
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=class-recordings
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto
MAX_UPLOAD_MB=500
UPLOAD_DIR=./uploads
